{
  "name": "asset-hub",
  "version": "0.1.9",
  "private": true,
  "description": "Browse the Unity projects on GitHub, preview their assets and export them as .unitypackage.",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/dev-app-name.mjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/dev-app-name.mjs",
    "dist": "electron-vite build && electron-builder --mac dmg",
    "dist:web": "electron-vite build && electron-builder --mac zip && node scripts/make-web-installer.mjs",
    "release": "node scripts/publish-release.mjs",
    "usage": "node scripts/usage-report.mjs"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "i18next": "^23.16.8",
    "playwright-core": "^1.48.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.4",
    "three": "^0.170.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "releaseRepo": "SCVN-Dan/asset-hub-release",
  "feedbackRepo": "supercent-io/asset-hub-feedback"
}
